+/// Whether this machine can decode an HEVC stream with `decoder` (the
+/// `--decoder` value), so `hello.videoCaps` may offer it (§6.5).
+pub fn hevc_supported(decoder: &str) -> bool {
+    #[cfg(feature = "gstreamer")]
+    return gst_out::hevc_supported(decoder);
+    #[cfg(not(feature = "gstreamer"))]
+    {
+        let _ = decoder;
+        false
+    }
+}
