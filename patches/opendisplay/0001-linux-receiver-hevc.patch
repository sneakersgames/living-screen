+/// The codec of a video stream (§5): H.264 unless `streamConfig` says otherwise.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum Codec {
+    #[default]
+    H264,
+    Hevc,
+}
+
+impl Codec {
+    /// The `streamConfig.codec` / `videoCaps.codec` token (§6.5).
+    pub fn from_token(token: &str) -> Option<Codec> {
+        match token {
+            "h264" => Some(Codec::H264),
+            "hevc" => Some(Codec::Hevc),
+            _ => None,
+        }
+    }
+
+    pub fn token(self) -> &'static str {
+        match self {
+            Codec::H264 => "h264",
+            Codec::Hevc => "hevc",
+        }
+    }
+}
+
+/// HEVC NAL unit types this protocol cares about (`nal_unit_type`: six bits
+/// of the first header byte, after the forbidden zero bit).
+pub mod hevc {
+    pub const VPS: u8 = 32;
+    pub const SPS: u8 = 33;
+    pub const PPS: u8 = 34;
+
+    pub fn nal_type(nal: &[u8]) -> Option<u8> {
+        Some((*nal.first()? >> 1) & 0x3f)
+    }
+
+    /// A random access picture (BLA, IDR, CRA): decoding can start here.
+    pub fn is_random_access(nal_type: u8) -> bool {
+        (16..=21).contains(&nal_type)
+    }
+}
+
 /// Find the first 4-byte start code at or after `from`.
 fn find_start_code(buf: &[u8], from: usize) -> Option<usize> {
     if buf.len() < 4 {
@@ -105,21 +148,38 @@ pub struct VideoFrame<'a> {
     pub annexb: &'a [u8],
     pub sps: Option<&'a [u8]>,
     pub pps: Option<&'a [u8]>,
+    /// A keyframe: an H.264 IDR picture or an HEVC random access picture.
     pub is_idr: bool,
+    pub codec: Codec,
 }
 
 impl<'a> VideoFrame<'a> {
+    /// Parse a frame of the legacy H.264 stream.
     pub fn parse(payload: &'a [u8]) -> Result<VideoFrame<'a>, VideoFrameError> {
+        Self::parse_as(payload, Codec::H264)
+    }
+
+    /// Parse a frame of the codec `streamConfig` announced (§6.5: the codec
+    /// comes from `streamConfig`, never from the bitstream).
+    pub fn parse_as(payload: &'a [u8], codec: Codec) -> Result<VideoFrame<'a>, VideoFrameError> {
         let first = find_start_code(payload, 0).ok_or(VideoFrameError::NoStartCode)?;
         let telemetry = Telemetry::parse_lenient(&payload[..first]);
         let annexb = &payload[first..];
         let (mut sps, mut pps, mut is_idr) = (None, None, false);
         for nal in nal_units(annexb) {
-            match NalType::of(nal) {
-                Some(NalType::Sps) => sps = Some(nal),
-                Some(NalType::Pps) => pps = Some(nal),
-                Some(NalType::IdrSlice) => is_idr = true,
-                _ => {}
+            match codec {
+                Codec::H264 => match NalType::of(nal) {
+                    Some(NalType::Sps) => sps = Some(nal),
+                    Some(NalType::Pps) => pps = Some(nal),
+                    Some(NalType::IdrSlice) => is_idr = true,
+                    _ => {}
+                },
+                Codec::Hevc => match hevc::nal_type(nal) {
+                    Some(hevc::SPS) => sps = Some(nal),
+                    Some(hevc::PPS) => pps = Some(nal),
+                    Some(t) if hevc::is_random_access(t) => is_idr = true,
+                    _ => {}
+                },
             }
         }
         Ok(VideoFrame {
@@ -128,13 +188,18 @@ impl<'a> VideoFrame<'a> {
             sps,
             pps,
             is_idr,
+            codec,
         })
     }
 
     /// Video dimensions from the SPS, if this frame carries one (§5.2:
     /// receivers MUST take dimensions from the SPS, never from `hello`).
+    /// Only H.264 SPS are parsed; an HEVC frame reports none.
     pub fn sps_info(&self) -> Option<Result<SpsInfo, VideoFrameError>> {
-        self.sps.map(SpsInfo::parse)
+        match self.codec {
+            Codec::H264 => self.sps.map(SpsInfo::parse),
+            Codec::Hevc => None,
+        }
     }
 }
 
