+        fn set_codec(&mut self, codec: Codec) -> Result<()> {
+            if codec == self.codec {
+                return Ok(());
+            }
+            if codec == Codec::Hevc && gst::ElementFactory::find("h265parse").is_none() {
+                return Err(anyhow!(
+                    "GStreamer element `h265parse` missing (install gst-plugins-bad)"
+                ));
+            }
+            info!("stream codec is now {}", codec.token());
+            self.codec = codec;
+            // A different parser and decoder: only a new pipeline has them.
+            self.recreate()?;
+            self.stall_after = self.pushed + 15;
+            self.warned_stall = false;
+            Ok(())
+        }
+
         fn poll_error(&mut self) -> Option<String> {
             // Also on the tick: a static desktop sends few frames, so the
             // "nothing within a second of the IDR" rule must not wait for one.
