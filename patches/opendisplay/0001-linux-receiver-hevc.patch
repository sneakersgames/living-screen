-    fn launch_description(cfg: &VideoConfig) -> String {
+    /// The decoder element for `codec`. `--decoder` names an H.264 decoder;
+    /// for HEVC its sibling is used (avdec_h264 -> avdec_h265, vah264dec ->
+    /// vah265dec), and decodebin3 picks one where there is none.
+    fn decoder_for(cfg: &VideoConfig, codec: Codec) -> String {
+        if codec == Codec::H264 || cfg.decoder == "decodebin3" {
+            return cfg.decoder.clone();
+        }
+        let sibling = cfg.decoder.replace("h264", "h265");
+        if sibling != cfg.decoder && gst::ElementFactory::find(&sibling).is_some() {
+            sibling
+        } else {
+            "decodebin3".into()
+        }
+    }
+
+    const TRUSTED_H265: &[&str] = &["avdec_h265", "vah265dec", "nvh265dec", "v4l2h265dec"];
+
+    pub fn hevc_supported(decoder: &str) -> bool {
+        if gst::init().is_err() || gst::ElementFactory::find("h265parse").is_none() {
+            return false;
+        }
+        let sibling = decoder.replace("h264", "h265");
+        if decoder != "decodebin3" && sibling != decoder {
+            if gst::ElementFactory::find(&sibling).is_some() {
+                return true;
+            }
+        }
+        TRUSTED_H265
+            .iter()
+            .any(|n| gst::ElementFactory::find(n).is_some_and(|f| f.rank() > gst::Rank::NONE))
+    }
+
+    fn launch_description(cfg: &VideoConfig, codec: Codec) -> String {
         let sink = match cfg.sink {
             SinkKind::Wayland => {
                 let mut s = String::from("waylandsink sync=false");
@@ -218,13 +269,17 @@ pub mod gst_out {
         } else {
