# The driver is loaded from the initramfs, so that is made again: with this
# driver after an install or update, with the stock one after a removal.
# pacman runs depmod only after these functions, so it is run here first.
_odimac_initramfs() {
  local d
  for d in /usr/lib/modules/*/; do
    [[ -e ${d}modules.order ]] && depmod "$(basename "$d")"
  done
  if command -v limine-mkinitcpio >/dev/null; then
    limine-mkinitcpio        # Omarchy: unified kernel images for Limine
  else
    mkinitcpio -P
  fi
}
post_install() {
  _odimac_initramfs
  echo ">>> The 5K driver is used from the next start."
}
post_upgrade() { post_install; }
post_remove() {
  _odimac_initramfs
  echo ">>> The stock driver (3840x2160) is used from the next start."
}
