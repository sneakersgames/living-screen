#!/bin/bash
# Panel and suspend policy for the display session. Runs inside Hyprland.
#
#   panel on   while a sender is connected, and for PANEL_OFF_DELAY seconds
#              after boot, resume, a cable plug-in or the end of a session;
#              and for as long as gaming or the desktop is showing
#   panel off  otherwise (display power off: backlight dark, machine idle)
#   suspend    optional, only with no cable, no session and the display
#              mode showing (SUSPEND_AFTER)
#
# "Cable" is a thunderbolt-net interface: the kernel creates one when the
# far end of the Thunderbolt cable is a computer. "Session" is an established
# TCP connection to the receiver's port. The mode is the environment whose
# workspace is showing, as hyprland.lua records it.
. "${ODIMAC_LIB:-/usr/lib/odimac}/common.sh"
SYSFS="${ODIMAC_SYSFS:-/sys}"
POLL="${ODIMAC_POLL:-1}"
MODE_FILE="${ODIMAC_RUN:-${XDG_RUNTIME_DIR:-/tmp}}/odimac-mode"

log() { echo "$*" >&2; }

cable_present() {
  local d
  for d in "$SYSFS"/class/net/*; do
    [[ -e $d ]] || continue
    [[ ${d##*/} == thunderbolt* ]] && return 0
    [[ $(readlink -f "$d/device/driver" 2>/dev/null) == */thunderbolt-net ]] && return 0
  done
  return 1
}

session_active() {
  [[ -n $(ss -Htn state established "( sport = :$RECEIVER_PORT )" 2>/dev/null) ]]
}

current_mode() { cat "$MODE_FILE" 2>/dev/null || echo display; }

panel_power() { [[ $(hypr eval "odimac.panel(\"$1\")" 2>/dev/null) == ok* ]]; }
panel=unknown
set_panel() {
  [[ $panel == "$1" ]] && return
  if panel_power "$1"; then
    panel=$1
    log "panel $1 ($2)"
  fi
}

if [[ -n $BRIGHTNESS ]]; then
  brightnessctl -q set "${BRIGHTNESS}%" 2>/dev/null || log "no backlight control, BRIGHTNESS ignored"
fi

# The stitched 5K driver can come up with only the left half of the picture
# stretched across the panel; one power cycle of the output corrects it.
stitch=$(cat "$SYSFS/module/amdgpu/parameters/tiled_stitch" 2>/dev/null)
if [[ $PANEL_POWER_CYCLE == 1 || ( $PANEL_POWER_CYCLE == auto && $stitch == 1 ) ]]; then
  sleep 3
  panel_power off && sleep 2 && panel_power on && log "panel power-cycled (5K driver)"
fi

now=$(date +%s)
lit_until=$((now + PANEL_OFF_DELAY))
alone_since=$now
had_cable=0
had_session=0
had_mode=display
load_logged=0
LOAD_LOG_INTERVAL=${ODIMAC_LOAD_INTERVAL:-60}
log "started (panel off after ${PANEL_OFF_DELAY}s idle, suspend after ${SUSPEND_AFTER}s)"

while session_running; do
  prev=$now
  now=$(date +%s)
  # A jump in the clock means the machine slept: start over as after boot.
  if (( now - prev > 30 )); then
    log "resumed from sleep"
    lit_until=$((now + PANEL_OFF_DELAY))
    alone_since=$now
    had_cable=0
    panel=unknown
  fi

  cable=0; cable_present && cable=1
  session=0; session_active && session=1

  if (( cable && !had_cable )); then
    log "cable plugged in"
    lit_until=$((now + PANEL_OFF_DELAY))
  fi
  (( !cable && had_cable )) && log "cable removed"
  if (( session )); then
    lit_until=$((now + PANEL_OFF_DELAY))
  fi
  (( session && !had_session )) && log "sender connected"
  (( !session && had_session )) && log "sender disconnected"
  mode=$(current_mode)
  if [[ $mode != "$had_mode" ]]; then
    log "mode $mode"
    # Back on the Mac's display: wait for a sender as after a session.
    [[ $mode == display ]] && lit_until=$((now + PANEL_OFF_DELAY))
  fi
  had_cable=$cable
  had_session=$session
  had_mode=$mode

  # During a session, note the machine's load in the journal once a minute.
  if (( session )); then
    if (( now - load_logged >= LOAD_LOG_INTERVAL )); then
      # The command substitution cannot update the baseline; the second
      # call does.
      line=$(load_sample)
      load_sample >/dev/null
      [[ -n $line ]] && log "load: $line"
      load_logged=$now
    fi
  else
    load_logged=0
  fi

  if [[ $mode != display ]]; then
    set_panel on "$mode mode"
  elif (( session )); then
    set_panel on "sender connected"
  elif (( now < lit_until )); then
    set_panel on "waiting for a sender"
  else
    set_panel off "idle"
  fi

  if (( cable || session )) || [[ $mode != display ]]; then
    alone_since=$now
  elif (( SUSPEND_AFTER > 0 && now - alone_since >= SUSPEND_AFTER )); then
    log "no cable for ${SUSPEND_AFTER}s, suspending"
    alone_since=$now
    systemctl suspend || log "suspend failed"
    sleep 10
  fi

  sleep "$POLL"
done
