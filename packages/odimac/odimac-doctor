#!/bin/bash
# Diagnostics for the OpenDisplay iMac appliance.
#   odimac-doctor                 report on panel, decoding, Thunderbolt, receiver
#   odimac-doctor suspend-test    check that suspend works and what wakes it
#   odimac-doctor decode-bench    measure how fast this machine decodes a 4K stream
#   odimac-doctor last-start      the last lines logged before the previous shutdown or freeze
#   odimac-doctor load            watch CPU use, temperatures and fan (Ctrl+C stops)
. /usr/lib/odimac/common.sh

h() { printf '\n== %s ==\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

report() {
  h "Machine"
  echo "model:   $(cat /sys/class/dmi/id/product_name 2>/dev/null)  (iMac18,3 is the 2017 27\" 5K)"
  echo "kernel:  $(uname -r)"
  echo "appliance: $(pacman -Q odimac opendisplay-receiver 2>/dev/null | tr '\n' ' ')"

  h "Panel"
  for c in /sys/class/drm/card*-*; do
    [[ -e $c/status ]] || continue
    printf '%s: %s' "${c##*/}" "$(<"$c/status")"
    [[ $(<"$c/status") == connected ]] && printf ', best mode %s' "$(head -n1 "$c/modes" 2>/dev/null)"
    echo
  done
  stitch=$(cat /sys/module/amdgpu/parameters/tiled_stitch 2>/dev/null)
  case $stitch in
    1) echo "5K driver: active (expect 5120x2880 above)" ;;
    "") echo "5K driver: not installed, stock amdgpu (expect 3840x2160 above)" ;;
    *) echo "5K driver: installed but tiled_stitch=$stitch" ;;
  esac
  if mons=$(hypr monitors 2>/dev/null) && [[ $mons == Monitor* ]]; then
    sed -n '1,2p' <<<"$mons" | sed 's/^\s*//'
    grep -m1 -E '^\s*dpmsStatus' <<<"$mons" | sed 's/^\s*dpmsStatus: 1/panel: on/; s/^\s*dpmsStatus: 0/panel: off (idle)/'
  else
    echo "display session: NOT running (journalctl -b -u odimac-kiosk)"
  fi
  echo "mode: $(/usr/lib/odimac/mode status)  (Ctrl+Alt+1 Mac display, +2 gaming, +3 desktop)"
  bl=$(ls /sys/class/backlight 2>/dev/null | tr '\n' ' ')
  echo "backlight control: ${bl:-none (BRIGHTNESS has no effect)}"

  h "Video decoding"
  if have vainfo; then
    render=$(ls /dev/dri/renderD* 2>/dev/null | head -n1)
    profiles=$(vainfo --display drm --device "$render" 2>/dev/null | grep VAEntrypointVLD)
    echo "VA-API H.264: $(grep -q H264 <<<"$profiles" && echo yes || echo NO)"
    echo "VA-API HEVC:  $(grep -q HEVC <<<"$profiles" && echo yes || echo NO)"
  fi
  for el in vah264dec vah265dec avdec_h264; do
    printf 'GStreamer %-11s %s\n' "$el:" "$(gst-inspect-1.0 --exists "$el" 2>/dev/null && echo yes || echo no)"
  done
  echo "in use: $RECEIVER_DECODER (RECEIVER_DECODER; avdec_* decode on the CPU, va* on the Radeon)"

  h "Sound"
  sed -n 's/^ *\([0-9]\+\) \[\([^ ]*\) *\].*/card \1: \2/p' /proc/asound/cards 2>/dev/null
  for c in /proc/asound/card*/codec#*; do
    [[ -r $c ]] && echo "  ${c#/proc/asound/}: $(sed -n 's/^Codec: //p' "$c")"
  done
  if modinfo -F filename snd-hda-codec-cs8409 2>/dev/null | grep -q /updates/; then
    echo "iMac sound driver (speakers, headphone jack): installed$(lsmod | grep -q '^snd_hda_codec_cs8409' || echo ', NOT loaded')"
  else
    echo "iMac sound driver: NOT installed (no speakers; USB audio works)"
  fi
  if uid=$(id -u odimac 2>/dev/null) && [[ -S /run/user/$uid/pipewire-0 ]]; then
    sinks=$(runuser -u odimac -- env XDG_RUNTIME_DIR="/run/user/$uid" wpctl status 2>&1 |
      sed -n '/^Audio/,/^Video/p' | sed -n '/Sinks:/,/Sources:/p' | grep '[0-9]\. ' | cut -c1-100)
    echo "outputs (* is the one in use):"
    echo "${sinks:-  none: PipeWire sees no sound card}"
  else
    echo "PipeWire: NOT running for the display session (as user odimac: systemctl --user status pipewire.socket)"
  fi

  h "Trouble"
  # Graphics card hangs and kernel faults, in this start and the one before.
  for b in 0 -1; do
    journalctl -k -b "$b" --no-pager -o short 2>/dev/null |
      grep -i -E 'amdgpu.*(timeout|reset|hang|fail)|ring .* timeout|kernel BUG|\bBUG:|Oops|TILED_STITCH: logical modeset|panic|hard lockup|soft lockup|graphics card was reset' |
      tail -n 8 | cut -c1-170 | sed "s/^/[start $b] /"
  done
  echo "(nothing above this line: no graphics or kernel faults were logged)"
  echo "('kernel BUG at ...amdgpu_dm.c' is the 5K driver crash behind the freezes; 'logical modeset"
  echo " of live root needs no reprogramming' is the fixed driver stepping around it)"
  drv=/usr/lib/modules/$(uname -r)/updates/amdgpu.ko.zst
  if [[ -e $drv ]]; then
    if zstdcat "$drv" 2>/dev/null | grep -qa 'logical modeset of live root'; then
      echo "5K driver: has the fix for that crash"
    else
      echo "5K driver: WITHOUT the fix for that crash (update odimac-amdgpu5k, then mkinitcpio -P)"
    fi
  fi

  h "Network (gaming)"
  for n in /sys/class/net/e*; do
    [[ -e $n ]] || continue
    echo "${n##*/}: $(cat "$n/operstate" 2>/dev/null), $(cat "$n/speed" 2>/dev/null || echo '?') Mbit/s (1000 expected; 100 means a poor cable or port)"
  done
  echo "receive buffer limit: $(( $(sysctl -n net.core.rmem_max) / 1024 )) KiB (8192 wanted for 4K streams)"

  h "Thunderbolt"
  if [[ -d /sys/bus/thunderbolt/devices ]]; then
    for d in /sys/bus/thunderbolt/devices/*; do
      [[ -r $d/device_name ]] && echo "${d##*/}: $(cat "$d/vendor_name" 2>/dev/null) $(<"$d/device_name")"
    done
  else
    echo "NO Thunderbolt controller visible to Linux"
  fi
  lsmod | grep -q '^thunderbolt_net' && echo "thunderbolt-net: loaded" || echo "thunderbolt-net: NOT loaded"
  found=0
  for n in /sys/class/net/thunderbolt*; do
    [[ -e $n ]] || continue
    found=1
    echo "cable link ${n##*/}: carrier $(cat "$n/carrier" 2>/dev/null || echo ?)"
    ip -brief addr show dev "${n##*/}"
  done
  (( found )) || echo "no cable link: no computer on the Thunderbolt port (or it is asleep)"

  h "Receiver"
  if nft list table inet odimac >/dev/null 2>&1; then
    echo "reachable: over the Thunderbolt cable only"
  else
    echo "reachable: over every network interface (odimac-firewall is off)"
  fi
  if ss -Hltn "( sport = :$RECEIVER_PORT )" | grep -q .; then
    echo "listening on port $RECEIVER_PORT as \"$RECEIVER_NAME\""
  else
    echo "NOT listening on port $RECEIVER_PORT"
  fi
  peers=$(ss -Htn state established "( sport = :$RECEIVER_PORT )" | awk '{print $NF}')
  echo "sender: ${peers:-none connected}"
  journalctl -b -t odimac-receiver -t odimac-powerd --no-pager -o cat 2>/dev/null |
    grep -v " INFO stats " | cut -c1-160 | tail -n 20

  h "Load"
  load_sample; sleep 2; load_sample
  journalctl -b -t odimac-powerd --no-pager -o cat 2>/dev/null | grep '^load: ' | tail -n 5

  h "Power"
  echo "sleep states: $(cat /sys/power/state 2>/dev/null)  mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)"
  echo "PANEL_OFF_DELAY=$PANEL_OFF_DELAY SUSPEND_AFTER=$SUSPEND_AFTER"
}

suspend_test() {
  (( EUID == 0 )) || { echo "run as root"; exit 1; }
  cat <<'MSG'
Test 1: does suspend work at all? The machine sleeps and wakes itself after
30 seconds. If the screen does not come back within a minute, suspend does
not work on this machine with this kernel: hold the power button, and leave
SUSPEND_AFTER=0.
MSG
  read -rp "Unplug the Thunderbolt cable, then press Enter (Ctrl+C to abort) "
  /usr/lib/odimac/wake-sources pre
  rtcwake -m mem -s 30 || { echo "suspend failed"; exit 1; }
  echo "Test 1 passed: resumed."
  cat <<'MSG'

Test 2: does plugging the cable in wake it? The machine sleeps with no
timer. Wait ten seconds, then plug the Thunderbolt cable into the awake
MacBook. If nothing happens within 20 seconds, press the power button
briefly to wake it.
MSG
  read -rp "Press Enter to sleep "
  before=$(date +%s)
  systemctl suspend
  sleep 15
  echo "Resumed after $(( $(date +%s) - before )) s."
  echo "Wake interrupt: $(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo unknown)"
  journalctl -b -k --no-pager --since "@$before" | grep -i -E 'wake|thunderbolt|PM: ' | tail -n 15
  cat <<'MSG'

If the cable woke it (not the power button): set SUSPEND_AFTER (for example
600) in /etc/odimac/odimac.conf and `systemctl restart odimac-kiosk`.
MSG
}

decode_bench() {
  local n=${BENCH_FRAMES:-240} dir
  dir=$(mktemp -d) || exit 1
  trap 'rm -rf "$dir"' EXIT
  bench() { # clip, parser, label, decoder pipeline
    local t0 t1
    t0=$(date +%s.%N)
    # shellcheck disable=SC2086
    if gst-launch-1.0 -q filesrc location="$1" ! $2 ! $4 ! fakesink sync=false 2>/dev/null; then
      t1=$(date +%s.%N)
      awk -v n="$n" -v a="$t0" -v b="$t1" -v l="$3" \
        'BEGIN { printf "  %-34s %5.0f fps  (%4.1f ms per frame)\n", l, n/(b-a), 1000*(b-a)/n }'
    else
      printf '  %-34s cannot decode this\n' "$3"
    fi
  }
  round() { # title, size, ffmpeg encoder options, format, parser, VA decoder, CPU decoder
    local clip=$dir/clip.$4
    echo "$1: making a $2 test clip of $n frames..."
    # shellcheck disable=SC2086
    ffmpeg -v error -y -f lavfi -i "testsrc2=size=$2:rate=60" -frames:v "$n" -pix_fmt yuv420p \
      $3 -b:v 18M -f "$4" "$clip" || { echo "  could not make the test clip"; return; }
    bench "$clip" "$5" "Radeon, frames stay on the GPU"  "$6"
    bench "$clip" "$5" "Radeon, frames copied to memory" "$6 ! video/x-raw,format=NV12"
    bench "$clip" "$5" "CPU"                             "$7"
    echo
  }
  round "H.264 as streamed today" "${BENCH_H264_SIZE:-4096x2304}" \
    "-c:v libx264 -preset ultrafast -tune zerolatency" h264 h264parse vah264dec avdec_h264
  round "HEVC at native 5K" "${BENCH_HEVC_SIZE:-5120x2880}" \
    "-c:v libx265 -preset ultrafast -tune zerolatency -x265-params log-level=error" hevc h265parse vah265dec avdec_h265
  cat <<'MSG'
These are top speeds on an easy clip. The Mac sends at most 55 frames per
second at the H.264 size and about 30 at native 5K, so a decoder is fast
enough when it is comfortably above that.
MSG
}

load_watch() {
  echo "Every 2 seconds; connect a sender and move things around. Ctrl+C stops."
  load_sample
  while sleep 2; do
    line=$(load_sample)
    echo "$(date +%T)  $line"
    load_sample >/dev/null
  done
}

case ${1:-} in
  "") report ;;
  suspend-test) suspend_test ;;
  decode-bench) decode_bench ;;
  load) load_watch ;;
  last-start)
    # What the machine wrote last before it went down, or stopped responding.
    journalctl -b -1 -n "${2:-45}" --no-pager -o short 2>/dev/null | cut -c8-170 ||
      echo "no log of an earlier start (the live stick keeps none)"
    ;;
  *) sed -n '2,7s/^# //p' "$0"; exit 1 ;;
esac
