#!/bin/bash
# Installs the running live system onto a disk, erasing it.
#   odimac-install [--hostname NAME] [--timezone ZONE] [--ssh-key FILE] [--no-password] DISK
# Run from the live USB stick, e.g. `odimac-install /dev/nvme0n1`.
set -euo pipefail

SRC=/run/archiso/airootfs
MNT=/mnt/odimac
hostname=imac-display
ssh_key=
timezone=
set_password=1
disk=

die() { echo "odimac-install: $*" >&2; exit 1; }
usage() { sed -n '2,4s/^# //p' "$0"; exit "${1:-1}"; }

while (( $# )); do
  case $1 in
    --hostname) hostname=${2:?}; shift 2 ;;
    --ssh-key) ssh_key=${2:?}; shift 2 ;;
    --timezone) timezone=${2:?}; shift 2 ;;
    --no-password) set_password=0; shift ;;
    -h|--help) usage 0 ;;
    -*) usage ;;
    *) disk=$1; shift ;;
  esac
done

(( EUID == 0 )) || die "run as root"
[[ -d $SRC/usr ]] || die "not running from the odimac live stick ($SRC missing)"
if [[ -z $disk ]]; then
  echo "Disks:"; lsblk -dno PATH,SIZE,MODEL,TRAN | sed 's/^/  /'
  usage
fi
[[ -b $disk && $(lsblk -dno TYPE "$disk") == disk ]] || die "$disk is not a whole disk"
[[ -z $ssh_key || -r $ssh_key ]] || die "cannot read $ssh_key"
[[ -z $timezone || -f /usr/share/zoneinfo/$timezone ]] || die "unknown time zone $timezone (see: timedatectl list-timezones)"
live=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
if [[ -n $live && $(lsblk -no PKNAME "$live" 2>/dev/null | head -n1) == "${disk##*/}" ]]; then
  die "$disk is the live stick"
fi
grep -q "^$disk" /proc/mounts && die "$disk has mounted partitions"

echo "This ERASES everything on $disk:"
lsblk -o PATH,SIZE,FSTYPE,LABEL,MODEL "$disk" | sed 's/^/  /'
echo "macOS, its recovery system and all data on this disk will be gone."
read -rp "Type the disk path again to continue: " answer
[[ $answer == "$disk" ]] || die "aborted"

cleanup() { umount -R "$MNT" 2>/dev/null || true; }
trap cleanup EXIT

echo "==> Partitioning $disk"
wipefs -af "$disk" >/dev/null
sfdisk --quiet --wipe always --wipe-partitions always --label gpt "$disk" <<PARTS
size=1GiB, type=uefi, name=odimac-esp
type=linux, name=odimac-root
PARTS
udevadm settle
mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" | awk '$2=="part"{print $1}')
(( ${#parts[@]} == 2 )) || die "expected 2 partitions on $disk, found ${#parts[@]}"
esp=${parts[0]} root=${parts[1]}
mkfs.fat -F32 -n ODIMAC-ESP "$esp" >/dev/null
mkfs.ext4 -q -F -L odimac-root "$root"

echo "==> Copying the system"
mkdir -p "$MNT"
mount "$root" "$MNT"
cp -a "$SRC"/. "$MNT"/
mkdir -p "$MNT/boot"
mount -o umask=0077 "$esp" "$MNT/boot"

echo "==> Configuring"
root_uuid=$(blkid -s UUID -o value "$root")
esp_uuid=$(blkid -s UUID -o value "$esp")
cat > "$MNT/etc/fstab" <<FSTAB
UUID=$root_uuid  /      ext4  rw,noatime    0 1
UUID=$esp_uuid   /boot  vfat  rw,umask=0077 0 2
FSTAB
echo "$hostname" > "$MNT/etc/hostname"
[[ -z $timezone ]] || ln -sf "/usr/share/zoneinfo/$timezone" "$MNT/etc/localtime"
: > "$MNT/etc/machine-id"
# Undo what only the live stick needs.
rm -f "$MNT/etc/mkinitcpio.conf.d/archiso.conf" "$MNT/etc/motd"
rm -rf "$MNT/etc/systemd/system/getty@tty2.service.d"
cat > "$MNT/etc/mkinitcpio.d/linux.preset" <<'PRESET'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default')
default_image="/boot/initramfs-linux.img"
PRESET

kver=$(ls "$MNT/usr/lib/modules" | head -n1)
install -m644 "$MNT/usr/lib/modules/$kver/vmlinuz" "$MNT/boot/vmlinuz-linux"
arch-chroot "$MNT" mkinitcpio -P

echo "==> Installing the boot loader"
arch-chroot "$MNT" bootctl install || arch-chroot "$MNT" bootctl install --no-variables
cat > "$MNT/boot/loader/loader.conf" <<'LOADER'
default odimac.conf
timeout 0
LOADER
# fbcon=nodefer: the text console takes the screen when the graphics driver
# starts. Left to the default it waits for the first line of console output,
# which on this quiet system comes late (a switch to the console, or
# shutdown) and then crashes the 5K graphics driver, freezing the picture
# and the keyboard.
cat > "$MNT/boot/loader/entries/odimac.conf" <<ENTRY
title   OpenDisplay iMac
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=UUID=$root_uuid rw quiet loglevel=3 systemd.show_status=false rd.udev.log_level=3 vt.global_cursor_default=0 fbcon=nodefer
ENTRY

if [[ -n $ssh_key ]]; then
  install -d -m700 "$MNT/root/.ssh"
  install -m600 "$ssh_key" "$MNT/root/.ssh/authorized_keys"
  arch-chroot "$MNT" systemctl enable sshd.service
  echo "==> ssh enabled for root with $ssh_key"
fi
if (( set_password )); then
  echo "==> Password for root (local login on Ctrl+Alt+F2)"
  until arch-chroot "$MNT" passwd root; do :; done
else
  arch-chroot "$MNT" passwd -l root >/dev/null
fi

sync
cleanup
trap - EXIT
cat <<DONE

Installed. Remove the USB stick and reboot.
If the iMac waits on a grey screen for a long time before starting, hold
Option at power-on once, then hold Control while choosing "EFI Boot": that
makes it the default.
DONE
