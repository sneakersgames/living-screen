#!/bin/bash
# Run once per graphics card reset (90-odimac-gpu-reset.rules): the session
# that was running cannot draw any more, so start it afresh. Open programs
# are closed by that; there is no saving them. After
# https://github.com/ahmadtv/omarchy-imac18-3.
echo "graphics card was reset: restarting the display session" | systemd-cat -t odimac-powerd -p warning
sleep 2 # let the driver finish first
systemctl restart odimac-kiosk.service
