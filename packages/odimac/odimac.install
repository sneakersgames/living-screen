post_install() {
  systemctl enable odimac-kiosk.service odimac-firewall.service systemd-networkd.service
  systemctl set-default graphical.target
}
pre_remove() {
  systemctl disable odimac-kiosk.service odimac-firewall.service
}
post_upgrade() {
  # 0.2.0 added the Thunderbolt-only firewall.
  if (( $(vercmp "$2" 0.2.0) < 0 )); then
    systemctl enable odimac-firewall.service
  fi
}
