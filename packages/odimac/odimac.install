post_install() {
  # What the package ships takes effect without a restart; nothing is
  # switched on here.
  sysctl -q --system 2>/dev/null || true
  modprobe -q thunderbolt-net 2>/dev/null || true
  nmcli connection reload 2>/dev/null || true
  echo ">>> Run 'odimac-setup' as yourself to turn the Mac display and gaming on."
}
post_upgrade() {
  nmcli connection reload 2>/dev/null || true
  echo ">>> Log out and in again (or reboot) to run the new version."
}
pre_remove() {
  systemctl disable --now odimac-firewall.service 2>/dev/null || true
  echo ">>> 'odimac-setup remove' would have taken the line out of your ~/.config/hypr/hyprland.lua;"
  echo ">>> it does nothing without the package, and can be deleted by hand."
}
