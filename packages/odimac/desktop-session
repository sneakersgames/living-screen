#!/bin/bash
# The desktop session: Hyprland on its own virtual terminal, as the kiosk
# user. Run by odimac-desktop.service, which `mode desktop` starts.
. /usr/lib/odimac/common.sh
# This service holds the terminal open, so logind starts no login prompt on
# it when it comes to the front.
/usr/lib/odimac/mode vt "$DESKTOP_VT"
stitch=$(cat /sys/module/amdgpu/parameters/tiled_stitch 2>/dev/null)
if [[ $PANEL_POWER_CYCLE == 1 || ( $PANEL_POWER_CYCLE == auto && $stitch == 1 ) ]]; then
  export ODIMAC_PANEL_CYCLE=1
fi
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
unset SWAYSOCK
cd "$HOME" || exit 1
exec Hyprland --config /usr/share/odimac/hyprland.lua
