#!/bin/bash
# Switches what the panel shows, from a script or a terminal. The keys
# (Ctrl+Alt+1, 2, 3) and the bar's buttons do the same.
#
#   mode display   the OpenDisplay receiver (the default)
#   mode game      Moonlight, streaming games from a PC; started on first use
#   mode desktop   the desktop, on the workspace it was last on
#   mode status    prints the current mode
#   mode watch     returns to "display" after MODE_IDLE_RETURN seconds without
#                  input (started once by the session)
#
# All three are workspaces of the one Hyprland session; the switching itself
# is in /usr/share/odimac/hyprland.lua (odimac.mode). The current mode is in
# $XDG_RUNTIME_DIR/odimac-mode, which is how odimac-powerd knows to keep the
# panel lit.
. "${ODIMAC_LIB:-/usr/lib/odimac}/common.sh"

case ${1:-} in
  display|game|desktop)
    out=$(hypr eval "return odimac.mode(\"$1\")") || { echo "the display session is not running" >&2; exit 1; }
    [[ $out == ok* ]] || { echo "$out" >&2; exit 1; }
    ;;
  status)
    cat "${ODIMAC_RUN:-/run/user/$(id -u odimac 2>/dev/null || id -u)}/odimac-mode" 2>/dev/null || echo display
    ;;
  watch)
    (( MODE_IDLE_RETURN > 0 )) || exit 0
    exec swayidle -w timeout "$MODE_IDLE_RETURN" "hyprctl eval 'odimac.idle()' >/dev/null"
    ;;
  *) echo "usage: ${0##*/} display|game|desktop|status|watch" >&2; exit 2 ;;
esac
