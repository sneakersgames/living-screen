[Unit]
Description=OpenDisplay iMac desktop session (Hyprland + Quickshell)
# Started on demand by /usr/lib/odimac/mode desktop (Ctrl+Alt+3), not at boot.
After=systemd-user-sessions.service dbus.socket systemd-logind.service odimac-kiosk.service getty@tty3.service
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty3.service
ConditionPathExists=/dev/tty0

[Service]
Type=exec
User=odimac
PAMName=odimac-kiosk
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty3
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/lib/odimac/desktop-session
# Logged out or crashed: back to the Mac's display.
ExecStopPost=/usr/lib/odimac/mode end desktop
Restart=no
