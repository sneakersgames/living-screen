# The Thunderbolt cable to the MacBook (macOS: "Thunderbolt Bridge"), for
# NetworkManager. Link-local addresses only: the Mac sender recognises a
# direct cable by the absence of any routable address, and connects on its
# own when it sees one. Without this, NetworkManager tries DHCP on the cable
# and never finishes.
[connection]
id=OpenDisplay Thunderbolt cable
uuid=6f3c1d0e-4b52-4c0e-9d3a-0d1a5c7e9a41
type=ethernet
autoconnect-priority=100
mdns=0
llmnr=0

[match]
interface-name=thunderbolt*;

[ipv4]
method=link-local

[ipv6]
method=link-local
