#!/usr/bin/nft -f
# The receiver is only reachable, and only visible, over the Thunderbolt
# cable. Without this, a Mac on the same network as the iMac's Ethernet or
# Wi-Fi finds it there and tries to use it over Wi-Fi instead.
#
# Omarchy's own firewall (ufw) already refuses the receiver's ports from
# those networks; this table says so again, should ufw be off, and adds what
# ufw leaves open: mDNS (5353), by which the receiver announces itself. That
# has a price on the desktop: nothing on this machine finds things by name
# on the local network any more (printers, .local names, Moonlight finding
# the PC by itself: add the PC there by address).
# Turn off with:  sudo systemctl disable --now odimac-firewall
table inet odimac
delete table inet odimac
table inet odimac {
  chain input {
    type filter hook input priority filter; policy accept;
    iifname "lo" accept
    iifname "thunderbolt*" accept
    tcp dport 9000 drop
    udp dport { 9001, 5353 } drop
  }
  chain output {
    type filter hook output priority filter; policy accept;
    oifname "lo" accept
    oifname "thunderbolt*" accept
    udp dport 5353 drop
  }
}
